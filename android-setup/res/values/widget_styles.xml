        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#1C2A23</item>
        <item name="android:background">@drawable/pill_off_light</item>
    </style>
    <string name="widget_description_compact">Şehir, sıradaki vakit ve bugünün 5 vakti (tek satır)</string>
    <string name="widget_description_mini">Şehir, sıradaki vakit ve kılınan vakit sayısı</string>
