<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_light">

    <TextView
        android:id="@+id/city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gelişim Takip"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#7A857E" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/level"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/next_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gelişim Takip"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1C2A23" />

        <Chronometer
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#1C2A23" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/p0" style="@style/WidgetPill" android:text="Sabah" />
        <TextView android:id="@+id/p1" style="@style/WidgetPill" android:text="Öğle" />
        <TextView android:id="@+id/p2" style="@style/WidgetPill" android:text="İkindi" />
        <TextView android:id="@+id/p3" style="@style/WidgetPill" android:text="Akşam" />
        <TextView android:id="@+id/p4" style="@style/WidgetPill" android:text="Yatsı" />
    </LinearLayout>

    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:textColor="#7A857E"
        android:text="Gelişim Takip" />
</LinearLayout>
